# Copy to .env (never commit .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=analytics
READONLY_PASSWORD=change-me-readonly

MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=5000
REFERENCE_DATE=2026-01-15


# --- LLM (Part 2) ---
# Provider: "anthropic" or "openai" (OpenAI-compatible servers like Ollama also work, see below)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave empty for the provider default (anthropic: claude-sonnet-5-5, openai: gpt-4o)
LLM_MODEL=
# Only for OpenAI-compatible servers, e.g. Ollama: LLM_PROVIDER=openai, LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Total tries per question: 1 initial + (N-1) repairs
MAX_ATTEMPTS=3
